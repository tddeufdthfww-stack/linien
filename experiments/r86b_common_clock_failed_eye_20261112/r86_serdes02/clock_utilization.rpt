# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells system_clock]

# Location of BUFIO Primitives 
set_property LOC BUFIO_X1Y9 [get_cells sample_clock]
set_property LOC BUFIO_X1Y8 [get_cells data_clock]

# Location of BUFR Primitives 
set_property LOC BUFR_X1Y9 [get_cells data_divider]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y75 [get_ports clk125_n]
set_property LOC IOB_X1Y76 [get_ports clk125_p]

# Clock net "sys_clk" driven by instance "system_clock" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_sys_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_sys_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=clock_manager} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="sys_clk"}]]]
resize_pblock [get_pblocks {CLKAG_sys_clk}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "io_div" driven by instance "data_divider" located at site "BUFR_X1Y9"
#startgroup
create_pblock {CLKAG_io_div}
add_cells_to_pblock [get_pblocks  {CLKAG_io_div}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="io_div"}]]]
resize_pblock [get_pblocks {CLKAG_io_div}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup
