# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells system_clock]
set_property LOC BUFGCTRL_X0Y17 [get_cells reference_double]

# Location of BUFH Primitives 
set_property LOC BUFHCE_X1Y24 [get_cells data_clock]

# Location of BUFIO Primitives 
set_property LOC BUFIO_X1Y9 [get_cells sample_clock]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X1Y134 [get_cells dac_wrt_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X1Y75 [get_ports clk125_n]
set_property LOC IOB_X1Y76 [get_ports clk125_p]

# Clock net "sys_clk" driven by instance "system_clock" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_sys_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_sys_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=clock_manager} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="sys_clk"}]]]
resize_pblock [get_pblocks {CLKAG_sys_clk}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "fabric_double" driven by instance "reference_double" located at site "BUFGCTRL_X0Y17"
#startgroup
create_pblock {CLKAG_fabric_double}
add_cells_to_pblock [get_pblocks  {CLKAG_fabric_double}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="fabric_double"}]]]
resize_pblock [get_pblocks {CLKAG_fabric_double}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup

# Clock net "dac_wrt_OBUF" driven by instance "data_clock" located at site "BUFHCE_X1Y24"
#startgroup
create_pblock {CLKAG_dac_wrt_OBUF}
add_cells_to_pblock [get_pblocks  {CLKAG_dac_wrt_OBUF}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=dac_wrt_OBUF_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="dac_wrt_OBUF"}]]]
resize_pblock [get_pblocks {CLKAG_dac_wrt_OBUF}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
#endgroup
